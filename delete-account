<script src="js/supabase-config.js"></script>
<script>
(function(){
  'use strict';
  var SB_URL = window.SUPABASE_URL || 'https://gxgytumhknmnwspxjzxw.supabase.co';
  var SB_KEY = window.SUPABASE_ANON_KEY || 'sb_publishable_cf3Z72lUE6PLCb2m42OFLA_znE8JK2r';

  // Prefill the email field if the visitor is signed in via the shared
  // website session (js/auth.js), so returning users don't retype it.
  try {
    var s = localStorage.getItem('pm_session');
    if (s) {
      var sess = JSON.parse(s);
      var email = sess && sess.user && sess.user.email;
      if (email) document.getElementById('daEmail').value = email;
    }
  } catch (e) {}

  document.getElementById('daForm').addEventListener('submit', function (ev) {
    ev.preventDefault();
    var btn = document.getElementById('daSubmitBtn');
    var statusEl = document.getElementById('daStatus');
    statusEl.className = 'da-status';
    statusEl.textContent = '';

    var email = document.getElementById('daEmail').value.trim();
    var reason = document.getElementById('daReason').value.trim();

    if (!email || email.indexOf('@') === -1) {
      statusEl.className = 'da-status err';
      statusEl.textContent = 'Please enter a valid email address.';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Submitting...';

    // No direct deletion happens from the frontend. This only inserts a
    // pending request row; an admin reviews and triggers the actual
    // deletion via the process_account_deletion Edge Function.
    fetch(SB_URL + '/rest/v1/account_deletion_requests', {
      method: 'POST',
      headers: {
        'apikey': SB_KEY,
        'Authorization': 'Bearer ' + SB_KEY,
        'Content-Type': 'application/json',
        'Prefer': 'return=minimal',
      },
      body: JSON.stringify({
        user_id: null,
        email: email,
        reason: reason || null,
        status: 'pending',
      }),
    }).then(function (res) {
      btn.disabled = false;
      btn.textContent = 'Submit Deletion Request';
      if (res.ok) {
        statusEl.className = 'da-status ok';
        statusEl.textContent = 'Your deletion request has been submitted. Our team will process it shortly.';
        document.getElementById('daForm').reset();
      } else {
        return res.json().catch(function () { return {}; }).then(function (body) {
          statusEl.className = 'da-status err';
          statusEl.textContent = 'Could not submit your request (' + (body.message || res.status) + '). Please email chakusaprince@gmail.com instead.';
        });
      }
    }).catch(function () {
      btn.disabled = false;
      btn.textContent = 'Submit Deletion Request';
      statusEl.className = 'da-status err';
      statusEl.textContent = 'Network error. Please try again or email chakusaprince@gmail.com.';
    });
  });
})();
</script>

