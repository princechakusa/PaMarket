# Local release-signing credentials for PaMarket.
# Copy to "keystore.properties" (same dir) and fill in real values.
# This file (the .example) is committed; keystore.properties is GITIGNORED.
# In CI we do NOT use this file — see docs/SIGNING.md (env vars / GitHub secrets).
storeFile=/absolute/path/to/pamarket.keystore
storePassword=your-store-password
keyAlias=pamarket
keyPassword=your-key-password
