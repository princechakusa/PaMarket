<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ forces a system splash on every cold start (cannot be disabled).
         Make it a blank blue frame (blue background + blue-on-blue icon) so no logo
         shows and it blends seamlessly into the HTML splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#1A3A8F</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#1A3A8F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

</resources>
