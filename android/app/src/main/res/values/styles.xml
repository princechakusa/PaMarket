<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#1A3A8F</item>
        <item name="colorPrimaryDark">#1A3A8F</item>
        <item name="colorAccent">#F5A623</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- Status/nav bar appearance is set at runtime in MainActivity via
             WindowCompat + WindowInsetsControllerCompat (the modern edge-to-edge
             API). The deprecated android:statusBarColor / windowLightStatusBar
             theme items were removed — they are ignored on Android 15+ and were
             what triggered Play Console's "deprecated APIs for edge-to-edge"
             warning. White icons on the navy header are now handled by
             ic.setAppearanceLightStatusBars(false) in MainActivity. -->
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <!-- Solid blue behind the (transparent) WebView until the HTML splash paints — no black gap -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

</resources>
