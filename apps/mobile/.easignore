# EAS Build project archive excludes. When this file exists, EAS uses ONLY
# these rules (does not merge with .gitignore) — so this must cover
# everything, not just what git already ignores.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env*.local
*.tsbuildinfo

# Native build output — regenerated by prebuild, must never be uploaded
# (Windows file locks on native .so/.o intermediates crash the EAS tarball step)
/android
/ios
