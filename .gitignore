# Ignore scratch scripts, but NOT strip-admin.js — it is a required build step
# (package.json `npm run sync` depends on it to keep admin.html out of the
# native app bundles). Git cannot re-include a file inside an excluded dir, so
# the contents are excluded rather than the directory itself.
scripts/*
!scripts/strip-admin.js
package-lock.json
!qa-system/package-lock.json
!apps/mobile/package-lock.json
COMPLETION_REPORT.md
DETAILED_CHANGES.md
ENHANCEMENT_SUMMARY.md
IMPLEMENTATION_NOTES.md
QUICK_REFERENCE.md
supabase/.temp/

# Build artifacts (release bundles/apks copied to repo root)
*.aab
*.apk

# Signing keystores — keep private, never commit
*.keystore
*.jks
keystore.properties

# Throwaway design mockups / preview screenshots
preview/
.pw-browsers/
# website redesign preview artifacts (underscore-prefixed = throwaway tooling)
website/_*.html
website/_*.png
website/_*.js
website/_*.css
website/_*.json


# Bulk-import working files (generate with: node tools/import-listings.js --template)
listings-template.csv
listings-import*.csv
