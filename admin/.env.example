# Mock mode is the safe default and needs no Supabase configuration.
VITE_ADMIN_MODE=mock

# Live mode requires both values below. Use the project's browser-safe
# publishable key (sb_publishable_...) or legacy anon key, never a secret or
# service_role key. VITE_* values are embedded in the browser bundle.
# VITE_ADMIN_MODE=live
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
